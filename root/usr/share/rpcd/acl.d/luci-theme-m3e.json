{
	"luci-theme-m3e": {
		"description": "Grant access to M3E theme settings",
		"read": {
			"ubus": { "uci": [ "get" ] },
			"uci": [ "m3e" ]
		},
		"write": {
			"file": {
				"/www/luci-static/m3e/backgrounds/m3e-wallpaper-*.jpg": [ "write" ]
			},
			"ubus": {
				"file": [ "remove", "write" ],
				"uci": [ "commit", "set" ]
			},
			"uci": [ "m3e" ]
		}
	}
}
